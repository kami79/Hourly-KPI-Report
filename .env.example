# Database Credentials (ODBC / DSN)
DB_DSN=YOUR_TELECOM_DSN
DB_USERNAME=kpi_user
DB_PASSWORD=your_secure_db_password_here

# Database Query Settings (optional overrides)
DB_QUERIES_PATH=./sql
SQL_FILENAME=hourly_raw_counters.sql

# Output and Snapshot History Paths
REPORT_PATH=./output
HISTORY_PATH=./output/history

# Email / SMTP Notification Settings
SMTP_ENABLED=true
SMTP_SERVER=smtp.example.com
SMTP_PORT=25
SMTP_USE_TLS=false
EMAIL_SENDER=kpi-alerts@telecom.example.com
EMAIL_PASSWORD=your_email_password_here
EMAIL_RECIPIENTS=noc-core@telecom.example.com,engineering-leads@telecom.example.com

# Alerting & Incident Rules
ALERT_SEND_ON_CRITICAL=true
ALERT_SEND_ON_WARNING=false
ALERT_SEND_ON_ERROR=true
INCIDENT_WINDOW_HOURS=48
INCIDENT_LOOKBACK_SNAPSHOTS=48
